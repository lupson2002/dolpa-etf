# 돌파etf 환경변수 예시
# .env로 복사 후 실제 값 채우기

# Telegram 봇
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token
TELEGRAM_CHAT_ID=123456789

# 유니버스 크기 (선택)
US_ETF_TOP_N=400

# 로그 레벨 (선택)
LOG_LEVEL=INFO

# 이메일 (Gmail SMTP) — whitelist Excel 발송
# 발신/수신 = yunjin.mike.choi@gmail.com (자기발송).
# EMAIL_PASSWORD = Gmail '앱 비밀번호' 16자리 (2차인증 필수, 일반 비밀번호 X).
# https://myaccount.google.com/apppasswords
EMAIL_USER=yunjin.mike.choi@gmail.com
EMAIL_TO=yunjin.mike.choi@gmail.com
EMAIL_PASSWORD=your-16-char-app-password